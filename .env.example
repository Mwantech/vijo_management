# Safe browser configuration only. Never add platform credentials here.
VITE_MANAGEMENT_API_URL=http://localhost:4000

# Vijo Management API
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=4000
MANAGEMENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
MANAGEMENT_COOKIE_SAME_SITE=Strict
# Set only when the frontend and API share a parent domain and a domain cookie is required.
MANAGEMENT_COOKIE_DOMAIN=

# Browser admin auth. Keep these on the backend only.
MANAGEMENT_ADMIN_EMAIL=admin@nexvijo.com
# Generate with: pnpm password:hash
MANAGEMENT_ADMIN_PASSWORD_HASH=
# Development only. Production requires the bcrypt hash above.
MANAGEMENT_ADMIN_PASSWORD=change-this-password
MANAGEMENT_ADMIN_NAME=Vijo Admin
MANAGEMENT_ADMIN_ROLE=super_admin
VIJO_MANAGEMENT_SESSION_SECRET=replace-with-a-long-random-session-secret

# Server-to-server access to this Management API. Keep this on the backend only.
VIJO_MANAGEMENT_API_KEY=replace-with-a-long-random-api-key
# Generate the session secret and unique per-platform credentials with: pnpm secrets:generate

# Live backend URLs confirmed from each product's deployment config on 2026-08-31.
GRADEPOA_API_URL=https://gradepoa.onrender.com
GOODSCENES_API_URL=https://getgoodscenes.onrender.com
HMS_API_URL=https://bensmma.onrender.com
VIJOPOS_API_URL=https://point-of-sale-system-cbew.onrender.com

# Backend-only service credentials. The corresponding value must be set in each product backend.
GRADEPOA_MANAGEMENT_API_KEY=
GOODSCENES_MANAGEMENT_API_KEY=
HMS_MANAGEMENT_API_KEY=
VIJOPOS_MANAGEMENT_API_KEY=

# HMAC secrets for signed requests. Set the matching VIJO_MANAGEMENT_API_SECRET in each product.
GRADEPOA_MANAGEMENT_API_SECRET=
GOODSCENES_MANAGEMENT_API_SECRET=
HMS_MANAGEMENT_API_SECRET=
VIJOPOS_MANAGEMENT_API_SECRET=

MANAGEMENT_PLATFORM_TIMEOUT_MS=8000
MANAGEMENT_PLATFORM_RETRIES=1
MANAGEMENT_RATE_LIMIT_PER_MINUTE=240
