# Frontend build-time configuration. This is the only value below that may be exposed to Vite.
VITE_MANAGEMENT_API_URL=https://management-api.your-domain.com

# Management API runtime
NODE_ENV=production
MANAGEMENT_HOST=0.0.0.0
# Render/Railway normally inject PORT. MANAGEMENT_PORT overrides it when set.
PORT=4000
MANAGEMENT_ALLOWED_ORIGINS=https://management.your-domain.com
MANAGEMENT_BODY_LIMIT=32kb
MANAGEMENT_RATE_LIMIT_PER_MINUTE=240
MANAGEMENT_TRUST_PROXY=true

# Session cookie
# Use Strict when frontend/API are same-site custom domains. Use None for unrelated Vercel/Render domains.
MANAGEMENT_COOKIE_SAME_SITE=Strict
# Optional, for example .your-domain.com. Leave blank for a host-only cookie.
MANAGEMENT_COOKIE_DOMAIN=
MANAGEMENT_SESSION_TTL_MS=28800000
MANAGEMENT_SESSION_SECRET=

# Initial management administrator
MANAGEMENT_ADMIN_ID=primary-super-admin
MANAGEMENT_ADMIN_NAME=Vijo Admin
MANAGEMENT_ADMIN_EMAIL=admin@your-domain.com
MANAGEMENT_ADMIN_ROLE=super_admin
# Run `pnpm password:hash`; never configure MANAGEMENT_ADMIN_PASSWORD in production.
MANAGEMENT_ADMIN_PASSWORD_HASH=

# Authenticates trusted non-browser callers to the Management API itself.
# This is NOT one of the product integration keys.
MANAGEMENT_API_KEY=

# Confirmed live product API URLs
GRADEPOA_API_URL=https://gradepoa.onrender.com
GOODSCENES_API_URL=https://getgoodscenes.onrender.com
HMS_API_URL=https://bensmma.onrender.com
VIJOPOS_API_URL=https://point-of-sale-system-cbew.onrender.com

# Use a unique key and HMAC secret for every product.
# Generate them with `pnpm secrets:generate`.
GRADEPOA_MANAGEMENT_API_KEY=
GRADEPOA_MANAGEMENT_API_SECRET=
GOODSCENES_MANAGEMENT_API_KEY=
GOODSCENES_MANAGEMENT_API_SECRET=
HMS_MANAGEMENT_API_KEY=
HMS_MANAGEMENT_API_SECRET=
VIJOPOS_MANAGEMENT_API_KEY=
VIJOPOS_MANAGEMENT_API_SECRET=

# Upstream request policy
MANAGEMENT_PLATFORM_TIMEOUT_MS=8000
MANAGEMENT_PLATFORM_RETRIES=1

# Optional platform controls
GRADEPOA_ENABLED=true
GOODSCENES_ENABLED=true
HMS_ENABLED=true
VIJOPOS_ENABLED=true
