{
  "name": "vijo-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "node server/index.js",
    "password:hash": "node scripts/generate-password-hash.mjs",
    "secrets:generate": "node scripts/generate-management-secrets.mjs",
    "payments:setup": "node scripts/payments.mjs setup",
    "memberships:setup": "node scripts/memberships.mjs setup",
    "memberships:import": "node scripts/memberships.mjs import",
    "memberships:grant-owner": "node scripts/grant-membership.mjs",
    "payments:application": "node scripts/payments.mjs",
    "test:payments": "vitest run server/modules/payments/tests",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "lossless-json": "^4.3.1",
    "lucide-react": "^0.542.0",
    "mongoose": "^9.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
